# Optional: enable live OpenAI parsing (AI Planner + invoice Vision)
# Without this key, a rich client-side Czech simulation is used.
# Prefer per-venue key in Profil / Onboarding (openaiApiKey).
VITE_OPENAI_API_KEY=

# Optional: Supabase cloud inventory sync + Auth onboarding
# Without these keys, EventFlow uses local auth fallback + offline inventory.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: Stripe Billing Payment Links (SaaS paywall)
# Without links, onboarding uses a secure client-side payment simulation.
VITE_STRIPE_PAYMENT_LINK=
VITE_STRIPE_PAYMENT_LINK_LITE=
VITE_STRIPE_PAYMENT_LINK_TEAM=
VITE_STRIPE_PAYMENT_LINK_BUSINESS=
VITE_STRIPE_PAYMENT_LINK_ENTERPRISE=
